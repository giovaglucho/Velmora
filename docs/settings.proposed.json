{
  "_note": "PROPUESTA (PLAN §2.5). Inactiva: copiar a .claude/settings.json solo con aprobación del dueño. TODO-HUMANO",
  "permissions": {
    "allow": ["Bash(pnpm *)", "Bash(npx playwright *)", "Bash(blender -b *)"],
    "ask": ["Bash(rm *)"],
    "deny": ["Bash(git push --force*)", "Bash(git push -f*)"]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "pnpm -s lint:sim" }] }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Recordatorio: actualizá docs/progress/STATUS.md' >&2"
          }
        ]
      }
    ]
  }
}
