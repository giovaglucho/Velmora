{
  "name": "@reinos/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/api/index.ts & tsx watch src/relay/index.ts & wait",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/index.js",
    "start:relay": "node dist/relay/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  }
}
