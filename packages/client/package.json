{
  "name": "@reinos/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "predev": "pnpm --filter @reinos/asset-pipeline run gen",
    "dev": "vite",
    "prebuild": "pnpm --filter @reinos/asset-pipeline run gen",
    "build": "pnpm --filter @reinos/devlog run build && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@reinos/data": "workspace:*",
    "@reinos/shared": "workspace:*",
    "@reinos/sim": "workspace:*",
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  }
}
