{
  "name": "reinos-de-ceniza",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:det": "turbo run test:det",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && pnpm lint:sim",
    "lint:sim": "node tools/lint-sim/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:check": "pnpm --filter @reinos/data run check",
    "devlog": "pnpm --filter @reinos/devlog run build",
    "e2e": "playwright test --trace off",
    "bench": "pnpm --filter @reinos/headless run bench",
    "test:det:browsers": "pnpm --filter @reinos/headless run test:det:browsers",
    "e2e:render": "pnpm assets:gen && VITE_ENABLE_DEBUG=1 pnpm --filter @reinos/client build && playwright test -c playwright.render.config.ts --trace off",
    "perf:render": "pnpm assets:gen && VITE_ENABLE_DEBUG=1 pnpm --filter @reinos/client build && node e2e/perf/perf-render.mjs",
    "media:render": "pnpm assets:gen && VITE_ENABLE_DEBUG=1 pnpm --filter @reinos/client build && node e2e/perf/capture-media.mjs",
    "assets:gen": "pnpm --filter @reinos/asset-pipeline run gen"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.17.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
